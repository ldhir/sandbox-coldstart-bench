# Copy to .env and fill in. run.py loads this automatically if python-dotenv is installed.

# Blaxel — from the workspace settings / `bl login`
BL_WORKSPACE=your-workspace
BL_API_KEY=your-api-key

# Modal — from `modal token new` (or set these directly)
MODAL_TOKEN_ID=your-token-id
MODAL_TOKEN_SECRET=your-token-secret
